# Copy to .env and fill in, or export these in your shell before `npm run e2e`.
# Every spec that needs a URL skips cleanly when its variable is unset.

# Public playlist — powers playlist-listing.spec.mjs
E2E_PLAYLIST_URL=https://www.youtube.com/playlist?list=PLrAXtmErZgOeiKm4sgNOknGvNjby9efdf

# Private playlist — powers private-playlist.spec.mjs (needs `npm run e2e:login` first)
# Defaults to Liked Videos when unset.
E2E_PRIVATE_PLAYLIST_URL=https://www.youtube.com/playlist?list=LL

# Single video with captions — powers single-video.spec.mjs
E2E_VIDEO_URL=https://www.youtube.com/watch?v=dQw4w9WgXcQ

# Playlist used for the batch ZIP test (falls back to E2E_PLAYLIST_URL)
E2E_BATCH_URL=
# How many videos to download in the batch test (keep small — each is a real fetch)
E2E_BATCH_LIMIT=3