{
  "name": "youtube-subtitle-downloader-mv3",
  "version": "1.1.5",
  "description": "YouTube Subtitle Downloader with 3-tier fallback",
  "type": "module",
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.config.content.js && vite build -c vite.config.sniffer.js",
    "test": "node --experimental-test-module-mocks --test \"test/*.test.mjs\"",
    "preview": "vite preview",
    "pack": "npm run build && node scripts/pack.cjs",
    "zip": "npm run build && node scripts/zip.cjs",
    "clean": "rimraf dist builds",
    "bump": "node scripts/bump-version.mjs",
    "notes": "node scripts/release-notes.mjs",
    "e2e:login": "node e2e/login.mjs",
    "e2e": "npm run build && playwright test",
    "e2e:headed": "npm run build && playwright test --headed",
    "e2e:smoke": "playwright test e2e/smoke.spec.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "he": "^2.0.0",
    "striptags": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@playzone/youtube-transcript": "^1.0.0",
    "crx": "^5.0.1",
    "node-rsa": "^2.0.0",
    "rimraf": "^6.1.3",
    "terser": "^5.51.2",
    "tslib": "^2.8.1",
    "vite": "^8.3.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-static-copy": "^4.1.1",
    "youtubei.js": "^18.1.0"
  }
}
